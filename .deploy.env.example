# 腾讯云部署凭证（复制为 .deploy.env 后填入真实值）
# 获取位置：腾讯云控制台 → 访问管理 → API 密钥管理 → 新建密钥
# 注意：此文件已在 .gitignore 中，不会被提交

TENCENT_SECRET_ID=你的SecretId
TENCENT_SECRET_KEY=你的SecretKey

# 可选：留空则自动从密钥推断 APPID
# TENCENT_APPID=1250000000

# 可选：地域与函数名（有默认值）
# SCF_REGION=ap-beijing
# SCF_FUNCTION_NAME=campus-notify

# 可选：桶名，留空则自动生成 campus-notify-<APPID>
# COS_BUCKET=campus-notify
