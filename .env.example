# 复制为 .env 并填入真实值（.env 不入库，已在 .gitignore）

# ---- LLM 摘要（推荐 DeepSeek：https://platform.deepseek.com）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-填入你的DeepSeek密钥
LLM_MODEL=deepseek-chat

# ---- 微信推送（可选；不配置就只在本地生成通知面板）----
# 通道：serverchan = Server酱（微信扫码即得，免费 5 条/天，无需实名）
#       pushplus  = 推送加（免费 200 条/天，需手机号实名）
#       off       = 关闭推送
PUSH_CHANNEL=serverchan

# Server酱：https://sct.ftqq.com 微信扫码登录 → 复制 SendKey（SCT 或 sctp 开头）
SERVERCHAN_SENDKEY=

# 推送加（选 serverchan 时留空即可）：https://www.pushplus.plus 微信扫码 → 复制 token
PUSHPLUS_TOKEN=

# 推送模式：daily = 每天一条汇总（默认，推荐）
#          instant = 每有新通知就推
PUSH_MODE=daily
# daily 模式下最早几点推（0-23）。电脑当天开机晚了，会在开机后补推一次。
PUSH_DAILY_HOUR=8
# 每天最多推几条（防止异常刷屏）
PUSH_DAILY_LIMIT=5
# 单条消息里最多列几条通知（其余只报总数）
PUSH_MAX_ITEMS=8

# ---- 抓取参数 ----
CRAWL_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_SITE=10
MAX_ARTICLE_AGE_DAYS=120
